# Track deployable website source and infrastructure only; all private project work stays local.
/*
!/.gitignore
!/README.md
!/.github/
!/website/
!/infra/
/website/*
!/website/.gitignore
!/website/.env.example
!/website/.htmlvalidate.json
!/website/.prettierignore
!/website/.prettierrc.json
!/website/package.json
!/website/package-lock.json
!/website/astro.config.mjs
!/website/release-config.mjs
!/website/tsconfig.json
!/website/src/
!/website/public/
!/website/scripts/
!/website/tests/
**/.DS_Store
**/__pycache__/
**/*.pyc
**/node_modules/
**/.astro/
**/.env
**/.env.local
**/*.pem
