---
import Icon from './Icon.astro';
---

<section class="zip-check" id="check-your-zip" aria-labelledby="zip-check-title">
  <Icon name="pin" size={25} />
  <h2 id="zip-check-title">Check your ZIP code</h2>
  <div data-zip-check hidden>
    <label for="service-zip">Service ZIP code</label>
    <div class="zip-check-fields">
      <input
        id="service-zip"
        type="text"
        inputmode="numeric"
        autocomplete="off"
        aria-describedby="service-zip-help"
      />
      <button class="button button-dark" type="button" data-zip-submit>
        Check ZIP
      </button>
    </div>
    <p id="service-zip-help">Enter five digits, including any leading zero.</p>
    <p class="zip-result" role="status" data-zip-result></p>
  </div>
  <p>
    <a href="#coverage">See the full coverage list</a>, including the Montgomery County address
    rule.
  </p>
</section>

<script>
  import { postalCodes } from '../data/territory';

  const listedZIPs = new Set<string>([...postalCodes.PA, ...postalCodes.NJ]);
  const checker = document.querySelector<HTMLElement>('[data-zip-check]');
  const input = checker?.querySelector('input');
  const button = checker?.querySelector('[data-zip-submit]');
  const result = checker?.querySelector<HTMLElement>('[data-zip-result]');

  if (checker && input && button && result) {
    const checkZip = () => {
      const zip = input.value.trim();
      if (!/^[0-9]{5}$/.test(zip)) {
        input.setAttribute('aria-invalid', 'true');
        result.textContent = 'Enter a five-digit ZIP code.';
        return;
      }
      input.removeAttribute('aria-invalid');
      result.textContent = listedZIPs.has(zip)
        ? 'This ZIP is in our listed service area. Call or text to confirm your address, appliance and appointment.'
        : 'This ZIP is outside our individually listed ZIPs. Addresses in Montgomery County, PA are also covered. Call or text if you need to confirm your county or address.';
    };

    button.addEventListener('click', checkZip);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && !event.isComposing) {
        event.preventDefault();
        checkZip();
      }
    });
    input.addEventListener('input', () => {
      input.removeAttribute('aria-invalid');
      result.textContent = '';
    });
    checker.hidden = false;
  }
</script>

<style>
  .zip-check {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: clamp(20px, 4vw, 32px);
    min-width: 0;
  }

  .zip-check h2 {
    font-size: clamp(22px, 3.2vw, 28px);
    margin: 10px 0 16px;
  }

  .zip-check label {
    display: block;
    margin-bottom: 6px;
    font-weight: 700;
  }

  .zip-check-fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: stretch;
    gap: 8px;
  }

  .zip-check input {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    font: inherit;
    font-variant-numeric: tabular-nums;
    padding: 9px 12px;
    border: 1px solid var(--muted);
    border-radius: 10px;
    background: var(--paper);
    color: var(--forest-deep);
  }

  .zip-check-fields .button {
    margin: 0;
    padding-inline: 16px;
  }

  .zip-check p {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.5;
  }

  .zip-check a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .zip-result:not(:empty) {
    padding: 12px;
    border-left: 3px solid var(--ink);
    background: var(--cream);
    border-radius: 5px;
  }
</style>
