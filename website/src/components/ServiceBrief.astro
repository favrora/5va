---
import Icon from './Icon.astro';
interface Props {
  slug: string;
  symptoms: string[];
  icon: string;
}
const { symptoms, icon } = Astro.props;
---

<div class="service-brief">
  <div class="brief-top">
    <span class="brief-icon">
      <Icon name={icon} size={35} />
    </span>
  </div>
  <h2>Common symptoms</h2>
  <ul>
    {symptoms.slice(0, 3).map((symptom) => (
      <li>
        <Icon name="check" size={16} />
        <span>{symptom}</span>
      </li>
    ))}
  </ul>
</div>
