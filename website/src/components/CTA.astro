---
import Icon from './Icon.astro';
import { business } from '../data/business';
interface Props {
  title?: string;
}
const { title = 'Appliance trouble?\nLet’s talk about the repair' } = Astro.props;
---

<section class="cta-section">
  <div class="container cta-inner">
    <div>
      <h2>
        {title.split('\n').map((line) => (
          <span>{line}</span>
        ))}
      </h2>
      <p>Tell us the appliance, the problem and your ZIP code. We come to your home.</p>
    </div>
    <div class="cta-actions">
      <div class="cta-buttons">
        <a class="button button-dark" href={business.phoneHref} data-placement="page-cta">
          <Icon name="phone" size={19} /> Call {business.phone}
        </a>
        <a class="button cta-text-button" href={business.smsHref} data-placement="page-cta">
          <Icon name="chat" size={19} /> Text 5VA
        </a>
      </div>
      <span>Free initial call · Visit and repair fees are separate</span>
    </div>
  </div>
</section>
