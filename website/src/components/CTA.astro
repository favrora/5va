---
import Icon from './Icon.astro';
import { business } from '../data/business';
interface Props {
  title?: string;
}
const { title = 'Appliance trouble?\nLet’s talk about the repair' } = Astro.props;
---

<section class="cta-section">
  <div class="container cta-inner">
    <div>
      <h2>
        {title.split('\n').map((line) => (
          <span>
            {line}
            <br />
          </span>
        ))}
      </h2>
      <p>Tell us the appliance, symptom, and ZIP code. Household repairs only.</p>
    </div>
    <div class="cta-actions">
      <a class="button button-dark" href={business.phoneHref}>
        <Icon name="phone" size={19} /> {business.phone}
      </a>
      <span>Free call. No obligation to book.</span>
      <a class="text-link" href={business.smsHref}>
        Prefer to text? Message 5VA directly. <Icon name="arrow" size={16} />
      </a>
    </div>
  </div>
</section>
