---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { business } from '../data/business';
const { showPrivacyChoices = false } = Astro.props;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-identity">
        <Logo light />
        <p class="footer-summary">Appliance repair at your home.</p>
        <p class="footer-service-note">
          Every day, 7am–8pm
          <br />
          Philadelphia 19115 &amp; 19116 · Montgomery County
          <br />
          Selected PA &amp; NJ ZIPs
        </p>
      </div>
      <nav class="footer-links" aria-label="Footer navigation">
        <a href="/services/">Repair services</a>
        <a href="/service-areas/">Service areas</a>
        <a href="/about/">About 5VA</a>
        <a href="/reviews/">Google reviews</a>
        <a href="/blog/">Repair blog</a>
      </nav>
      <div class="footer-contact">
        <a
          class="footer-phone"
          href={business.phoneHref}
          data-placement="footer"
          aria-label={`Call 5VA Appliance Repair at ${business.phone}`}
        >
          {business.phone}
        </a>
        <div class="footer-contact-links">
          <a href={business.smsHref} data-placement="footer">
            <Icon name="chat" size={17} /> Send a text
          </a>
          <a href={business.mapsUrl} target="_blank" rel="noopener noreferrer">
            Find us on Google
          </a>
        </div>
        <p>
          Free initial call
          <br />
          Visit and repair fees are separate
        </p>
      </div>
    </div>
    <p class="footer-scope">
      No appliance sales · No retail parts sales · No commercial repairs · No drop-off
    </p>
    <div class="footer-bottom">
      <span>
        © {new Date().getFullYear()} {business.name}
      </span>
      <div>
        <a href="/privacy/">Privacy</a>
        {showPrivacyChoices && (
          <button type="button" class="privacy-choices" data-call-measurement-open hidden>
            Privacy choices
          </button>
        )}
        <a href="/contact/">Contact</a>
      </div>
    </div>
  </div>
</footer>
<div class="mobile-call-bar">
  <a href={business.phoneHref} data-track="phone_click" data-placement="mobile-bar">
    <Icon name="phone" size={18} />
    <span>
      Call 5VA <small>Free call</small>
    </span>
  </a>
  <a href={business.smsHref} data-placement="mobile-bar">
    <Icon name="chat" size={18} />
    <span>Text 5VA</span>
  </a>
</div>

<style>
  .privacy-choices {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .privacy-choices:hover {
    color: var(--yellow);
  }
</style>
