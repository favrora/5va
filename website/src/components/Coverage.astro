---
import { postalCodes } from '../data/territory';

interface Props {
  preserveZipAnchor?: boolean;
}
const { preserveZipAnchor = false } = Astro.props;
const states = [
  { name: 'Pennsylvania', slug: 'pennsylvania', zips: postalCodes.PA },
  { name: 'New Jersey', slug: 'new-jersey', zips: postalCodes.NJ },
];
---

<section class="section territory-section" id="coverage" aria-labelledby="coverage-heading">
  {preserveZipAnchor && <span id="check-your-zip" class="coverage-anchor" aria-hidden="true" />}
  <div class="container">
    <h2 id="coverage-heading">Covered ZIP codes</h2>
    <p class="coverage-summary">
      We also serve every address in{' '}
      <a href="/service-areas/montgomery-county/">Montgomery County, PA</a>, including ZIP codes
      beyond this list.
    </p>
    <div class="coverage-states">
      {states.map(({ name, slug, zips }) => (
        <div class="coverage-state">
          <h3>{name}</h3>
          <ul aria-label={`${name} service ZIP codes`}>
            {zips.map((code) => (
              <li>{code}</li>
            ))}
          </ul>
          <a class="text-link" href={`/service-areas/${slug}/`}>
            {name} service details <span aria-hidden="true">→</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .territory-section {
    position: relative;
  }

  .coverage-anchor {
    position: absolute;
    inset-block-start: 0;
  }

  .coverage-summary {
    max-width: 64ch;
    margin: 10px 0 24px;
    color: var(--muted);
    line-height: 1.65;
  }

  .coverage-summary a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .coverage-states {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: clamp(12px, 3vw, 24px);
  }

  .coverage-state {
    min-width: 0;
    padding: clamp(16px, 3vw, 28px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
  }

  .coverage-state h3 {
    font-size: clamp(19px, 2vw, 24px);
  }

  .coverage-state ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 14px 0 18px;
  }

  .coverage-state li {
    padding: 5px 10px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 8px;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .coverage-states {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
