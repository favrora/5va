---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import Icon from '../../components/Icon.astro';

import { articles, relatedArticles } from '../../data/journal';
import { services } from '../../data/content';
import { business } from '../../data/business';
export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}
const { article } = Astro.props;
const recommended = relatedArticles(article.slug);
const relevantServices = article.relatedServices
  .map((slug) => services.find((service) => service.slug === slug))
  .filter((service): service is (typeof services)[number] => Boolean(service));
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  inLanguage: 'en-US',
  wordCount: article.wordCount,
  articleSection: article.category,
  ...(article.publishedOn
    ? { datePublished: article.publishedOn, dateModified: article.publishedOn }
    : {}),
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  author: {
    '@type': 'Organization',
    name: '5VA Appliance Repair',
    url: new URL('/about/', Astro.site).href,
  },
  publisher: { '@id': new URL('/#business', Astro.site).href },
  image: new URL(article.image, Astro.site).href,
  about: relevantServices.map((service) => ({
    '@type': 'Service',
    name: service.title,
    url: new URL(`/services/${service.slug}/`, Astro.site).href,
  })),
  citation: article.sources.map((source) => source.url),
};
---

<Layout
  title={article.seoTitle}
  description={article.description}
  schema={schema}
  socialImage={article.image}
  socialImageAlt={article.imageAlt}
  socialImageHeight={800}
>
  <section class="page-hero guide-hero">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/blog/">Blog</a>
        <span>/</span>
        <span>Guide</span>
      </div>
      <h1>{article.title}</h1>
      <p class="lead">{article.description}</p>
      <p class="guide-byline">
        5VA Appliance Repair <span aria-hidden="true">·</span> Philadelphia, Pennsylvania
        {article.publishedOn && (
          <>
            {' '}
            <span aria-hidden="true">·</span>{' '}
            <time datetime={article.publishedOn}>
              {new Date(`${article.publishedOn}T12:00:00Z`).toLocaleDateString('en-US', {
                month: 'long',
                day: 'numeric',
                year: 'numeric',
                timeZone: 'UTC',
              })}
            </time>
          </>
        )}
      </p>
      <figure class="guide-cover">
        <img
          src={article.image}
          srcset={`/images/blog/${article.slug}-600.webp 600w, ${article.image} 1200w, /images/blog/${article.slug}-1536.webp 1536w`}
          sizes="(max-width: 1100px) 100vw, 1060px"
          alt={article.imageAlt}
          width="1200"
          height="800"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>
  </section>
  <section class="section guide-section">
    <div class="container article-layout">
      <aside class="article-sidebar">
        <nav class="article-toc" aria-label="Article sections">
          <h2>In this guide</h2>
          <a class="guide-skip" href="#guide-body">
            The quick answer
          </a>
          {article.sections.map((section, i) => (
            <a href={`#section-${i}`}>{section.heading}</a>
          ))}
          {article.faqs.length > 0 && <a href="#guide-questions">Common questions</a>}
          <a href="#related-services">Get appliance repair help</a>
        </nav>
        <div class="guide-contact">
          <Icon name="chat" size={25} />
          <h2>Need appliance repair?</h2>
          <p>Tell us the appliance, symptom, and ZIP code.</p>
          <a href={business.phoneHref} data-placement="article-sidebar">
            {business.phone}
          </a>
          <a href={business.smsHref} class="text-link" data-placement="article-sidebar">
            Prefer a text? Send an SMS <Icon name="arrow" size={16} />
          </a>
          <small>Free call. No obligation to book.</small>
        </div>
      </aside>
      <article class="prose guide-body" id="guide-body">
        <div class="guide-summary">
          <p>{article.takeaway}</p>
          <div class="guide-contact-actions">
            <a class="text-link" href={business.phoneHref} data-placement="article-summary">
              <Icon name="phone" size={18} /> Call {business.phone}
            </a>
            <a class="text-link" href={business.smsHref} data-placement="article-summary">
              <Icon name="chat" size={18} /> Text 5VA
            </a>
          </div>
        </div>
        {article.sections.map((section, i) => (
          <>
            <section id={`section-${i}`}>
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              {section.table && (
                <section class="guide-table-wrap" tabindex="0" aria-label={section.table.caption}>
                  <table class="guide-table">
                    <caption>{section.table.caption}</caption>
                    <thead>
                      <tr>
                        {section.table.headings.map((heading) => (
                          <th scope="col">{heading}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {section.table.rows.map((row) => (
                        <tr>
                          {row.map((cell, index) =>
                            index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>,
                          )}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </section>
              )}
              {section.links && (
                <ul class="guide-context-links">
                  {section.links.map((link) => (
                    <li>
                      <a href={link.href}>
                        {link.label} <Icon name="arrow" size={15} />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
            {i === 1 && (
              <p class="context-reading">
                For related symptoms and planning, read{' '}
                <a href={`/blog/${recommended[0].slug}/`}>{recommended[0].title}</a> and{' '}
                <a href={`/blog/${recommended[1].slug}/`}>{recommended[1].title}</a>.
              </p>
            )}
          </>
        ))}
        {article.faqs.length > 0 && (
          <section id="guide-questions" class="guide-questions">
            <h2>A few useful questions</h2>
            <FAQ items={article.faqs} />
          </section>
        )}
        <section id="related-services" class="guide-services">
          <h2>Find the right service for your home</h2>
          <p>
            Explore the work, see what information helps us prepare, and call for free to discuss
            your household appliance problem.
          </p>
          <div class="guide-service-links">
            {relevantServices.map((service) => (
              <a href={`/services/${service.slug}/`}>
                <Icon name={service.icon} size={23} />
                <span>
                  {service.title}
                  <small>Residential appliance repair</small>
                </span>
                <Icon name="arrow" size={18} />
              </a>
            ))}
          </div>
          <a class="text-link" href={business.smsHref}>
            Text us about this appliance <Icon name="arrow" size={17} />
          </a>
        </section>
        {article.sources.length > 0 && (
          <section class="article-sources">
            <h2>Sources and further reading</h2>
            <p>
              Manufacturer and public guidance can help with planning. Follow instructions for your
              particular product and situation.
            </p>
            <ul>
              {article.sources.map((source) => (
                <li>
                  <a href={source.url} target="_blank" rel="noopener noreferrer">
                    {source.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
        <section class="guide-related">
          <h2>Related appliance guides</h2>
          <div class="guide-related-links">
            {recommended.map((item) => (
              <a href={`/blog/${item.slug}/`}>
                <strong>{item.title}</strong>
                <Icon name="diagonal" size={18} />
              </a>
            ))}
          </div>
        </section>
      </article>
    </div>
  </section>
  <CTA />
</Layout>
