---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import RepairScope from '../components/RepairScope.astro';
import { business } from '../data/business';
---

<Layout
  title="About 5VA Appliance Repair | In-Home Service in Philadelphia"
  description="Learn what 5VA Appliance Repair works on, where we travel, and how an in-home repair visit works from the first call to the repair decision."
>
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <span>About 5VA</span>
      </div>
      <h1>About 5VA Appliance Repair</h1>
      <p class="lead">
        We visit homes to diagnose and repair kitchen and laundry appliances. We serve Philadelphia
        ZIP codes 19115 and 19116, all of Montgomery County, PA, and selected ZIP codes in
        Pennsylvania and New Jersey.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container about-grid">
      <figure class="about-visual">
        <img
          src="/images/work/technician-1200.webp"
          srcset="/images/work/technician-480.webp 480w, /images/work/technician-640-v2.webp 640w, /images/work/technician-800.webp 800w, /images/work/technician-1200.webp 1200w"
          sizes="(max-width: 400px) calc(100vw - 32px), (max-width: 700px) calc(100vw - 40px), (max-width: 950px) calc(100vw - 80px), 550px"
          alt="5VA technician working on a household refrigerator, from our Google Business Profile"
          width="1241"
          height="931"
          loading="lazy"
          decoding="async"
        />
        <figcaption>A 5VA refrigerator service visit, from our Google Business Profile.</figcaption>
      </figure>
      <div class="about-copy">
        <h2>Household appliance repair at your home</h2>
        <p>
          We work on refrigerators, freezers, ice makers, dishwashers, washers, dryers, cooking
          appliances and microwaves. Share the model and describe the problem so we can confirm
          whether it fits the service before you arrange a visit.
        </p>
        <p>
          We’re available every day from 7 AM to 8 PM Eastern. Visits are by appointment at your
          home. There is no customer drop-off location.
        </p>
        <RepairScope compact />
        <a class="text-link about-service-link" href="/services/">
          Explore appliance services <Icon name="arrow" size={17} />
        </a>
      </div>
    </div>
  </section>
  <section class="section about-visit">
    <div class="container">
      <h2>What to expect from a repair visit</h2>
      <ol class="about-steps">
        <li>
          <h3>Describe the problem</h3>
          <p>
            Tell us what the appliance is doing, when the problem started, and whether it shows an
            error code. A photo of the model label can help if you can reach it safely.
          </p>
        </li>
        <li>
          <h3>Confirm coverage and visit details</h3>
          <p>
            Share your town or ZIP code. We’ll confirm service at your address, discuss appointment
            availability, and explain any visit or diagnostic fee before you book. The initial call
            is free.
          </p>
        </li>
        <li>
          <h3>Review the proposed repair</h3>
          <p>
            After the assessment, review what the technician found, the proposed work, and the
            expected cost before deciding whether to proceed.
          </p>
        </li>
      </ol>
      <div class="about-links">
        <a class="text-link" href="/service-areas/#coverage">
          View locations and ZIP codes <Icon name="arrow" size={17} />
        </a>
        <a class="text-link" href="/blog/appliance-repair-visit-checklist/">
          Prepare for a repair visit <Icon name="arrow" size={17} />
        </a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="prose">
        <h2>See our work and customer feedback</h2>
        <p>
          The repair photo above comes from our Google Business Profile. Visit the original listing
          for work photos and current reviews, or read the dated English excerpts on our{' '}
          <a href="/reviews/">customer reviews page</a>.
        </p>
        <a class="text-link" href={business.mapsUrl} target="_blank" rel="noopener noreferrer">
          View 5VA on Google <Icon name="diagonal" size={16} />
        </a>
      </div>
    </div>
  </section>
  <CTA />
</Layout>

<style>
  .about-grid > * {
    min-width: 0;
  }

  .about-visual {
    margin: 0;
  }

  .about-visual figcaption {
    margin-top: 12px;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .about-copy p + p {
    margin-top: 1rem;
  }

  .about-service-link {
    margin-top: 1.25rem;
  }

  .about-visit {
    background: var(--surface-soft);
  }

  .about-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: clamp(12px, 2vw, 24px);
    margin: 24px 0;
    padding: 0;
    list-style: none;
  }

  .about-steps li {
    padding: clamp(16px, 2.4vw, 28px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .about-steps h3 {
    margin: 0 0 8px;
  }

  .about-steps p {
    margin: 0;
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }

  .about-links a {
    min-height: 44px;
  }
</style>
