---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import RepairScope from '../components/RepairScope.astro';
import { business } from '../data/business';
---

<Layout
  title="About 5VA Appliance Repair | Philadelphia Residential Service"
  description="Meet 5VA Appliance Repair: residential service at your home in Philadelphia 19115/19116, Montgomery County and selected PA/NJ ZIPs. Call or text directly."
>
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <span>About 5VA</span>
      </div>
      <h1>
        Focused on the appliances
        <br />
        your home depends on
      </h1>
      <p class="lead">
        5VA Appliance Repair helps households with kitchen and laundry appliance problems. We visit
        Philadelphia 19115 and 19116, all of Montgomery County, PA, and selected nearby PA/NJ ZIP
        codes by appointment.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container about-grid">
      <div class="about-visual">
        <img
          src="/images/work/technician-1200.webp"
          srcset="/images/work/technician-480.webp 480w, /images/work/technician-640-v2.webp 640w, /images/work/technician-800.webp 800w, /images/work/technician-1200.webp 1200w"
          sizes="(max-width: 400px) calc(100vw - 32px), (max-width: 700px) calc(100vw - 40px), (max-width: 950px) calc(100vw - 80px), 550px"
          alt="5VA technician working on a household refrigerator, from our Google Business Profile"
          width="1241"
          height="931"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="about-copy">
        <h2>Repair service at your home</h2>
        <p>
          Tell us the appliance, model, and what changed. We discuss suitability, travel, available
          appointments, and any visit or diagnostic fee before booking. After assessment, review the
          proposed work and expected cost before deciding.
        </p>
        <p style="margin-top:20px">
          We work at customers’ homes every day, 7am–8pm. There is no shop or customer drop-off
          location.
        </p>
        <RepairScope compact />
        <a class="text-link" style="margin-top:25px" href="/services/">
          Explore appliance services <Icon name="arrow" size={17} />
        </a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="prose">
        <h2>See our work and customer feedback</h2>
        <p>
          The repair photo above comes from our Google Business Profile. Visit the original listing
          for work photos and current reviews, or read the dated English excerpts on our{' '}
          <a href="/reviews/">customer reviews page</a>.
        </p>
        <a class="text-link" href={business.mapsUrl} target="_blank" rel="noopener noreferrer">
          View 5VA on Google <Icon name="diagonal" size={16} />
        </a>
        <p>
          Planning a visit? Our{' '}
          <a href="/blog/appliance-repair-visit-checklist/">appliance repair checklist</a> explains
          model photos, safe access, and authorization.
        </p>
      </div>
    </div>
  </section>
  <CTA />
</Layout>
