---
import Layout from '../layouts/Layout.astro';
import Reviews from '../components/Reviews.astro';
import CTA from '../components/CTA.astro';
import { googleReviewSummary } from '../data/business';
---

<Layout
  title="5VA Customer Reviews | Philadelphia Appliance Repair"
  description={`Read customer feedback for 5VA Appliance Repair. ${googleReviewSummary}`}
>
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <span>Customer reviews</span>
      </div>
      <h1>5VA Appliance Repair reviews</h1>
      <p class="lead">
        Read what customers shared about their refrigerator, dishwasher, and washing machine repair
        visits. The excerpts below are from our Google Business Profile, where you can read the
        complete reviews.
      </p>
    </div>
  </section>
  <Reviews />
  <CTA />
</Layout>
