---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import ServiceBrief from '../../components/ServiceBrief.astro';
import RepairScope from '../../components/RepairScope.astro';
import { preparation } from '../../data/projects';
import { services } from '../../data/content';
import { serviceGuides, serviceProof } from '../../data/service-guides';
import { serviceAreaSchema } from '../../data/territory';
import { business, reviews } from '../../data/business';
export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
const proof = serviceProof[service.slug];
const review = reviews.find((item) => item.author === proof?.reviewer);
const guides = serviceGuides[service.slug];
const relatedServiceSlugs: Record<string, string[]> = {
  'refrigerator-repair': ['freezer-repair', 'ice-maker-repair'],
  'washer-repair': ['dryer-repair'],
  'dryer-repair': ['washer-repair'],
  'oven-stove-repair': ['microwave-repair', 'dishwasher-repair'],
  'dishwasher-repair': ['refrigerator-repair', 'oven-stove-repair'],
  'freezer-repair': ['refrigerator-repair', 'ice-maker-repair'],
  'microwave-repair': ['oven-stove-repair'],
  'ice-maker-repair': ['refrigerator-repair', 'freezer-repair'],
};
const searchDescriptions: Record<string, string> = {
  'refrigerator-repair':
    'Fridge not cooling or leaking? In-home refrigerator repair in Philadelphia 19115/19116, Montgomery County and selected PA/NJ ZIPs. Call or text 5VA.',
  'washer-repair':
    'Washer not draining or spinning? In-home washing machine repair in Philadelphia 19115/19116 and selected PA/NJ areas. Call or text 5VA with your model.',
  'dryer-repair':
    'Dryer not heating or starting? Residential dryer repair in Philadelphia 19115/19116, Montgomery County and selected PA/NJ ZIPs. Call or text 5VA.',
  'oven-stove-repair':
    'Oven not heating or cooktop burner trouble? In-home oven and stove repair in Philadelphia 19115/19116 and selected PA/NJ areas. Call or text 5VA.',
  'dishwasher-repair':
    'Dishwasher not draining, leaking or cleaning well? In-home repair in Philadelphia 19115/19116, Montgomery County and selected PA/NJ ZIPs. Contact 5VA.',
  'freezer-repair':
    'Freezer warming up or icing over? Household freezer repair in Philadelphia 19115/19116 and selected PA/NJ ZIPs. Call or text 5VA with the model.',
  'microwave-repair':
    'Microwave not heating or controls not working? Household microwave repair in Philadelphia 19115/19116 and selected PA/NJ areas. Discuss your model with 5VA.',
  'ice-maker-repair':
    'No ice, small cubes or leaks? Household ice maker repair in Philadelphia 19115/19116, Montgomery County and selected PA/NJ ZIPs. Call or text 5VA.',
};
const base = new URL('/', Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.title,
    serviceType: service.title,
    description: searchDescriptions[service.slug],
    provider: { '@id': `${base}#business` },
    areaServed: serviceAreaSchema,
    url: canonical,
    mainEntityOfPage: { '@id': `${canonical}#webpage` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: base },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: new URL('/services/', Astro.site).href,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: service.title,
        item: canonical,
      },
    ],
  },
];
---

<Layout
  title={`${service.title} in Philadelphia | 5VA`}
  description={searchDescriptions[service.slug]}
  schema={schema}
>
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/services/">Services</a>
        <span>/</span>
        <span>{service.title}</span>
      </div>
      <div class="service-hero-grid">
        <div>
          <h1>{service.title} in Philadelphia</h1>
          <p class="lead">{service.description}</p>
          <div class="service-coverage">
            <Icon name="pin" size={20} />
            <p>
              In-home visits in{' '}
              <a href="/service-areas/philadelphia/">Philadelphia 19115 and 19116</a>,{' '}
              <a href="/service-areas/montgomery-county/">Montgomery County</a>, and selected PA and
              NJ ZIP codes.{' '}
              <a class="service-zip-link" href="/service-areas/#coverage">
                See all covered ZIP codes
              </a>
            </p>
          </div>
          <div class="service-hero-actions" data-tracking-region="service-hero">
            <a class="button button-yellow" href={business.phoneHref} data-placement="service-hero">
              <Icon name="phone" size={18} /> Call {business.phone}
            </a>
            <a class="button button-outline" href={business.smsHref} data-placement="service-hero">
              <Icon name="chat" size={18} /> Text us
            </a>
          </div>
          <span class="free-call">Free call. No obligation to book.</span>
        </div>
        <ServiceBrief slug={service.slug} symptoms={service.symptoms} icon={service.icon} />
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container detail-grid">
      <div class="prose">
        <h2>How to book an in-home visit</h2>
        <ol class="service-visit-steps">
          <li>
            <strong>Call or text.</strong> Share your town or ZIP, the problem and the model if it’s
            easy to find.
          </li>
          <li>
            <strong>Confirm the visit.</strong> We check coverage and appliance suitability and
            discuss any diagnostic fee before you book.
          </li>
          <li>
            <strong>Decide after inspection.</strong> If a repair is suitable, review the proposed
            work and price before approving it.
          </li>
        </ol>
        <RepairScope compact />
        <h2>{service.overviewTitle}</h2>
        <p>{service.intro}</p>
        {service.details.map((detail) => (
          <div class="details-block">
            <h3>{detail.title}</h3>
            <p>{detail.text}</p>
          </div>
        ))}
        <h2>Symptom and cost guides</h2>
        <ul class="service-guide-list">
          {guides.map(({ label, href }) => (
            <li>
              <a href={href}>
                {label} <Icon name="arrow" size={17} />
              </a>
            </li>
          ))}
        </ul>
        <section class="project-prep" id="project-preparation" aria-labelledby="prep-title">
          <h2 id="prep-title">Three things to send us</h2>
          <ol>
            {preparation[service.slug].items.map((item) => (
              <li>{item}</li>
            ))}
          </ol>
          <p class="prep-photo">
            <Icon name="chat" size={19} />
            <span>
              <strong>Helpful photos:</strong> {preparation[service.slug].photo}
            </span>
          </p>
          <a class="text-link" href={business.smsHref} data-placement="service-checklist">
            Text us about this appliance <Icon name="arrow" size={17} />
          </a>
        </section>
        <h2>Your questions, answered</h2>
        <FAQ items={service.faqs} />
        <h2>Related repair services</h2>
        <div class="mini-services">
          {services
            .filter((item) => relatedServiceSlugs[service.slug].includes(item.slug))
            .map((item) => (
              <a href={`/services/${item.slug}/`}>{item.shortTitle}</a>
            ))}
        </div>
        <p style="margin-top:25px">
          <a href="/services/">See all appliance repairs</a> or{' '}
          <a href="/blog/appliance-repair-visit-checklist/">prepare for your visit</a>.
        </p>
      </div>
      <aside class="service-support" aria-label="More about 5VA repairs">
        {proof && (
          <figure class="service-proof">
            <img
              src={`/images/work/${proof.photo.name}-card-320.webp`}
              srcset={`/images/work/${proof.photo.name}-card-320.webp 320w, /images/work/${proof.photo.name}-card-480.webp 480w`}
              sizes="(max-width: 540px) calc(100vw - 36px), (max-width: 800px) 440px, 320px"
              width="320"
              height="427"
              alt={proof.photo.alt}
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              Photo from <a href={business.mapsUrl}>5VA’s Google Business Profile</a>
            </figcaption>
          </figure>
        )}
        {review ? (
          <figure class="service-review">
            <blockquote>“{review.text}”</blockquote>
            <figcaption>
              <strong>{review.author}</strong>
              <span>
                {review.service} · {review.date}
              </span>
              <a href="/reviews/">More customer reviews</a>
            </figcaption>
          </figure>
        ) : (
          <div class="service-help">
            <h2>Check before you book</h2>
            <p>
              Have an unusual installation or a model you aren’t sure we cover? Share the details
              before arranging a visit.
            </p>
            <a class="text-link" href={business.smsHref} data-placement="service-sidebar">
              Text your appliance details <Icon name="arrow" size={16} />
            </a>
          </div>
        )}
      </aside>
    </div>
  </section>
  <CTA />
</Layout>

<style>
  .service-coverage {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin-top: 18px;
    max-inline-size: 55ch;
  }

  .service-coverage > :global(svg) {
    flex: none;
    margin-top: 2px;
  }

  .service-coverage p {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .service-coverage a,
  .service-support a:not(.text-link) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .service-coverage .service-zip-link {
    display: inline-block;
    color: var(--ink);
    font-weight: 700;
  }

  .service-hero-actions .button {
    margin-block-start: 0;
  }

  @media (min-width: 360px) and (max-width: 700px) {
    .service-hero-actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .service-hero-actions .button {
      padding-inline: 14px;
      font-size: 0.875rem;
    }
  }

  .service-visit-steps {
    display: grid;
    gap: 12px;
    margin: 0 0 24px;
    padding-inline-start: 1.4em;
    color: var(--muted);
    line-height: 1.65;
  }

  .service-visit-steps strong {
    color: var(--ink);
  }

  .service-guide-list {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service-guide-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-block-size: 44px;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: transparent;
    transition:
      color var(--link-motion),
      text-decoration-color var(--link-motion);
  }

  .service-guide-list a:hover,
  .service-guide-list a:focus-visible {
    color: var(--ink-hover);
    text-decoration-color: currentColor;
  }

  .service-guide-list a > :global(svg) {
    flex: none;
  }

  .service-support {
    display: grid;
    gap: 18px;
    min-inline-size: 0;
  }

  .service-proof,
  .service-review,
  .service-help {
    margin: 0;
    overflow-wrap: break-word;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--cream);
  }

  .service-proof img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 19px 19px 0 0;
  }

  .service-proof figcaption {
    padding: 14px 16px;
    font-size: 0.8rem;
  }

  .service-review,
  .service-help {
    padding: clamp(var(--space-4), 2.5vw, var(--space-5));
  }

  .service-review blockquote {
    margin: 0 0 12px;
    color: var(--ink);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .service-review figcaption {
    display: grid;
    gap: 4px;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .service-review strong {
    color: var(--ink);
  }

  .service-help {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    gap: var(--space-3);
  }

  .service-help h2 {
    margin: 0;
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    text-wrap: pretty;
  }

  .service-help p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .service-help .text-link {
    min-block-size: 44px;
    min-inline-size: 0;
    max-inline-size: 100%;
    padding-inline-end: var(--space-1);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition:
      color var(--link-motion),
      text-decoration-color var(--link-motion);
  }

  .service-help .text-link:is(:hover, :focus-visible) {
    color: var(--ink-hover);
    text-decoration-color: currentColor;
  }

  @media (max-width: 800px) {
    .service-support {
      inline-size: min(100%, 440px);
    }
  }
</style>
