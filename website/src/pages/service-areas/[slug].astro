---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';
import RepairScope from '../../components/RepairScope.astro';
import { areas, services } from '../../data/content';
import { serviceAreaSchema } from '../../data/territory';
import { business } from '../../data/business';

export function getStaticPaths() {
  return areas.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}

const { area } = Astro.props;
const areaServed = serviceAreaSchema.filter((item) =>
  'address' in item ? area.zips.includes(item.address.postalCode) : area.includesMontgomeryCounty,
);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Residential appliance repair in ${area.name}`,
  serviceType: 'Household appliance repair',
  provider: { '@id': new URL('/#business', Astro.site).href },
  areaServed,
  url: new URL(Astro.url.pathname, Astro.site).href,
  description: area.intro,
};

const commonAppliances = [
  { slug: 'washer-repair', label: 'Washer repair', symptom: 'Leaks, standing water or no spin' },
  { slug: 'dryer-repair', label: 'Dryer repair', symptom: 'No heat, tumble or power' },
  {
    slug: 'dishwasher-repair',
    label: 'Dishwasher repair',
    symptom: 'Poor cleaning, leaks or no drain',
  },
  {
    slug: 'refrigerator-repair',
    label: 'Refrigerator repair',
    symptom: 'Warm compartments, frost or leaks',
  },
];
const otherAppliances = services.filter(
  (service) => !commonAppliances.some((appliance) => appliance.slug === service.slug),
);
---

<Layout title={`${area.title} | 5VA`} description={area.description} schema={schema}>
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/service-areas/">Service areas</a>
        <span>/</span>
        <span>{area.name}</span>
      </div>
      <h1>{area.title}</h1>
      <p class="lead">{area.intro}</p>
      <div class="repair-actions">
        <a class="button button-yellow" href={business.phoneHref} data-placement="area-hero">
          <Icon name="phone" size={18} /> Call {business.phone}
        </a>
        <a class="button button-outline" href={business.smsHref} data-placement="area-hero">
          <Icon name="chat" size={18} /> Text about a visit
        </a>
      </div>
      <p class="free-call">Free initial call. Visit and repair fees are separate.</p>
    </div>
  </section>
  <section class="section">
    <div class="container detail-grid">
      <div class="prose">
        <h2>{area.zips.length ? 'Service ZIP codes' : 'Check your county address'}</h2>
        {area.zips.length > 0 && (
          <ul class="area-postal-list" aria-label={`${area.name} service ZIP codes`}>
            {area.zips.map((zip) => (
              <li>{zip}</li>
            ))}
          </ul>
        )}
        {area.slug === 'montgomery-county' && (
          <>
            <h3>Huntingdon Valley and Bryn Athyn</h3>
            <p>
              We visit homes in Bryn Athyn Borough and the Montgomery County part of Huntingdon
              Valley, including Lower Moreland Township. If your mailing address says Huntingdon
              Valley, confirm the property's county before booking. ZIP 19006 alone doesn't
              establish that the address is in Montgomery County.
            </p>
            <h3>Willow Grove, Upper Moreland and Abington</h3>
            <p>
              We also serve Willow Grove addresses in Montgomery County and homes throughout Upper
              Moreland and Abington townships. Tell us the municipality if it differs from the
              postal city on your address.
            </p>
          </>
        )}
        {area.slug === 'pennsylvania' && (
          <p>
            See the <a href="/service-areas/montgomery-county/">Montgomery County address guide</a>
            {', '}
            <a href="/service-areas/philadelphia/">Philadelphia service ZIPs</a>, or local coverage
            for <a href="/service-areas/levittown/">Levittown</a>
            {' and '}
            <a href="/service-areas/feasterville-trevose/">Feasterville-Trevose</a>.
          </p>
        )}
        {area.slug === 'levittown' && (
          <p>
            These are the two Levittown ZIPs we serve.{' '}
            <a href="/service-areas/#coverage">See other covered ZIP codes</a>.
          </p>
        )}
        {area.slug === 'northeast-philadelphia' && (
          <p>
            See the main{' '}
            <a href="/service-areas/philadelphia/">Philadelphia appliance repair page</a> for
            service options and ZIP coverage.
          </p>
        )}
        {area.slug === 'philadelphia' && (
          <p>
            For access and rental preparation, see our{' '}
            <a href="/service-areas/northeast-philadelphia/">Northeast Philadelphia visit guide</a>.
          </p>
        )}

        <h2>Kitchen and laundry appliance repair</h2>
        <ul class="area-service-links">
          {commonAppliances.map((appliance) => (
            <li>
              <a href={`/services/${appliance.slug}/`}>{appliance.label}</a>
              <span>{appliance.symptom}</span>
            </li>
          ))}
        </ul>
        <div class="mini-services">
          {otherAppliances.map((service) => (
            <a href={`/services/${service.slug}/`}>{service.shortTitle}</a>
          ))}
        </div>
        <RepairScope compact />

        <h2>Planning your home visit</h2>
        <p>{area.localNote}</p>
        <p>
          Use our <a href="/blog/appliance-repair-visit-checklist/">appliance visit checklist</a>{' '}
          for model photos, access and permission to approve the work. We quote repair work after an
          on-site inspection.
        </p>
        <p>
          <a href="/service-areas/#coverage">See all PA and NJ service areas and ZIP codes</a>.
        </p>
      </div>
      <aside class="info-panel">
        <Icon name="pin" size={30} />
        <h2>Confirm a home visit</h2>
        <p>
          Share your town or ZIP, appliance and symptom. We confirm coverage, the appointment and
          any visit fee before booking. {business.hours}.
        </p>
        <a class="button button-yellow" href={business.phoneHref} data-placement="area-booking">
          Call {business.phone}
        </a>
        <small>Free initial call</small>
        <a class="text-link" href={business.smsHref} data-placement="area-booking">
          Send an SMS <Icon name="chat" size={17} />
        </a>
        <a class="text-link" href={business.mapsUrl} target="_blank" rel="noopener noreferrer">
          View our Google listing <Icon name="diagonal" size={15} />
        </a>
      </aside>
    </div>
  </section>
  <CTA />
</Layout>

<style>
  .area-postal-list,
  .area-service-links {
    list-style: none;
    padding: 0;
  }

  .prose :is(.area-postal-list, .area-service-links) > li {
    margin-top: 0;
  }

  .area-postal-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0 22px;
  }

  .area-postal-list li {
    border: 1px solid var(--line);
    border-radius: 9px;
    padding: 6px 12px;
    background: var(--white);
    font-variant-numeric: tabular-nums;
  }

  .area-service-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 20px;
    margin: 14px 0;
  }

  .area-service-links li {
    display: flex;
    flex-direction: column;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
  }

  .area-service-links a {
    align-self: start;
    font-weight: 700;
  }

  .area-service-links span {
    margin-top: 2px;
    font-size: 14px;
  }

  @media (max-width: 410px) {
    .area-service-links {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
